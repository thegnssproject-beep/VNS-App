# server/.env.example — copy to server/.env and fill in real values.
# Do not commit server/.env (it contains credentials).

PORT=4000                          # Express API port
CORS_ORIGIN=http://localhost:5173  # Vite dev origin allowed by CORS
DB_HOST=127.0.0.1                  # MySQL host
DB_PORT=3306                       # MySQL port
DB_USER=root                       # MySQL user
DB_PASSWORD=your_sql_password      # must match the MySQL root password you set
DB_NAME=vns_app
NODE_ENV=development